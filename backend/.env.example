# Copy to backend/.env for local development. On Vercel, set these in Project Settings > Environment Variables.
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=nexstack
CORS_ORIGINS=http://localhost:3000

# Signup notifications via Gmail (SMTP_PASSWORD is a 16-character Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nexstacklogics@gmail.com
SMTP_PASSWORD=
NOTIFY_EMAIL=nexstacklogics@gmail.com

# Optional alternative to Gmail: a Resend API key (used first when set)
RESEND_API_KEY=
